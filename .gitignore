# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# google drive oauth
# credentials.json is the OAuth client downloaded from the Cloud console, and
# token.json is what scripts/google-oauth.ts writes: a refresh token that opens
# an organiser's entire Google Drive. Neither ever belongs in the repository.
credentials.json
token.json

# roster import
# Holds the rows the import could not use, which means real student names and
# addresses. Regenerate it by running the script; never commit it.
import-report.csv

# Agent worktrees. Temporary checkouts, not part of the project.
.claude/worktrees/
backfill-report.csv
