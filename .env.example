# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for the deployment. .env* is gitignored, so nothing here
# with a real value ever reaches the repository.

# Canonical origin, used for metadataBase and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="https://cesac-azure.vercel.app"

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------

# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out, which is also how you revoke every session.
AOT_SESSION_SECRET=""

# The account list, as one line of JSON. Leave it unset and the site falls back
# to the two public demo logins in src/lib/auth/accounts.ts, and says so on the
# sign-in page and the organiser console.
#
# Fields: id, role ("participant" | "admin"), identifier (email for
# participants, handle for organisers), name, password (a digest from
# `npm run hash-password -- "the password"`), code (organisers only, the
# six digit access code), partner (participants only, optional).
#
# AOT_ACCOUNTS='[{"id":"team-01","role":"participant","identifier":"duo@vit.edu","name":"Team Vanguard","partner":"A. Partner","password":"scrypt$16384$...$..."},{"id":"org-tech-01","role":"admin","identifier":"cesac.technical","name":"Technical Vertical","code":"402193","password":"scrypt$16384$...$..."}]'
AOT_ACCOUNTS=""
