# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for the deployment. .env* is gitignored, so nothing here
# with a real value ever reaches the repository.

# Canonical origin, used for metadataBase and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="https://cesac-azure.vercel.app"

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Both of these have working defaults checked into src/lib/supabase/config.ts,
# so a fresh clone and a fresh deploy both run without setting anything. Set
# them only to point a deployment at a different project, a staging branch for
# instance. Both are public by design and end up in the browser bundle either
# way: the publishable key grants nothing that row level security does not.
#
# The deployment holds no service role key. Organiser powers ride on the
# signed-in user's own role, checked by the database, so there is no all-access
# key to leak.
# NEXT_PUBLIC_SUPABASE_URL="https://lgshgaltulbnjqfxjsme.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# Service role key, for the roster import only
# ---------------------------------------------------------------------------
# Needed by `npx tsx scripts/import-students.ts --commit`, and by nothing else.
# It overrides every row level security policy in the project, so it belongs on
# a laptop for the few minutes the import takes and nowhere else. Do NOT set it
# in Vercel: no route reads it, and the running site does not want it.
#
# Supabase dashboard -> Project Settings -> API -> service_role. Delete it from
# here once the import has run.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Google Drive, for certificate uploads
# ---------------------------------------------------------------------------
# Leave these unset and the dashboard says uploads are not switched on yet,
# rather than failing. Full setup, including why the parent folder has to be in
# a shared drive rather than somebody's My Drive, is in the README under
# "Certificates and Google Drive".
#
# Server only. Neither value reaches the browser.
#
# The JSON key file from Google Cloud, pasted whole:
GOOGLE_SERVICE_ACCOUNT_JSON=""
#
# Or, if one enormous value is awkward to manage, the same thing split up. The
# \n escapes in the key are handled, and so are stray wrapping quotes.
# GOOGLE_SERVICE_ACCOUNT_EMAIL="cesac-certificates@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# The "Department Certificates" folder, from its address bar: .../folders/THIS
GOOGLE_DRIVE_PARENT_FOLDER_ID=""

# ---------------------------------------------------------------------------
# Razorpay, optional
# ---------------------------------------------------------------------------
# Leave both unset and the site offers the offline payment route only: teams
# pay by UPI or at the desk and record the reference, and an organiser verifies
# it. Set both, then switch "Razorpay checkout" on in the organiser console, and
# the pay button appears as well.
#
# The secret is server only. It never reaches the browser: it signs the order
# request and verifies the signature Razorpay sends back.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
